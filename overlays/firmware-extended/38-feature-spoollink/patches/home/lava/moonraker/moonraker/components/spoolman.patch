+    def take_unsent(self, spool_id: int) -> float:
+        """Remove and return the usage of a spool that was not delivered.
+
+        A request that is on the way may already be applied by Spoolman. Its
+        amount stays in the send loop, which learns the outcome from the reply.
+        A 404 returns that amount through `_spool_missing`.
+        """
+        lost = self.pending_reports.pop(spool_id, 0.)
+        sending = self._usage_operations.get(spool_id)
+        inflight = self._inflight_reports.pop(spool_id, 0.)
+        if sending is not None and inflight:
+            kept = min(sending['length'], inflight)
+            self._inflight_reports[spool_id] = kept
+            lost += inflight - kept
+        else:
+            lost += inflight
+            self._usage_operations.pop(spool_id, None)
+        self._save_usage()
+        return lost
+
+    def _save_usage(self, deferred: bool = False) -> asyncio.Future:
+        spoollink = self.server.lookup_component('spoollink', None)
+        if spoollink is not None:
+            if deferred:
+                # Klipper keeps running totals, so a lost tail of new feed is
+                # counted again. Moves of waiting usage are saved at once.
+                spoollink.request_save()
+                saved = asyncio.get_running_loop().create_future()
+                saved.set_result(None)
+                return saved
+            return spoollink.save_state()
+        saved = asyncio.get_running_loop().create_future()
+        saved.set_result(None)
+        return saved
 
