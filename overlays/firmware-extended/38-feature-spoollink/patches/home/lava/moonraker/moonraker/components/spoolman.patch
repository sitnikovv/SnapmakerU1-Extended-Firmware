+    async def _used_length(self, spool_id: int) -> Optional[float]:
+        """The used length stored in Spoolman, or None when the spool is gone."""
+        response = await self.http_client.get(
+            f"{self.spoolman_url}/v1/spool/{spool_id}", enable_cache=False)
+        if response.status_code == 404:
+            return None
+        if response.has_error():
+            raise self.server.error(self._get_response_error(response))
+        return float(response.json().get('used_length') or 0.)
+
+    def _spool_missing(self, spool_id: int) -> None:
+        lost = (self.pending_reports.pop(spool_id, 0.)
+                + self._inflight_reports.pop(spool_id, 0.))
+        self._usage_operations.pop(spool_id, None)
+        bridge = self.server.lookup_component('spoollink', None)
+        if bridge is not None and self._use_router:
+            bridge.spool_missing(spool_id, lost)
+        if spool_id == self.spool_id:
+            self.set_active_spool(None)
+
+    async def _send_reports(self, protected: bool) -> None:
+        for spool_id in list(self._inflight_reports):
+            while spool_id in self._inflight_reports:
+                if not self.ws_connected or self.is_closing:
+                    break
+                available = self._inflight_reports[spool_id]
+                operation = self._usage_operations.get(spool_id)
+                applied = False
+                if protected:
+                    # The server cannot recognize a repeated request. So the used
+                    # length is compared with the value seen before the first try.
+                    used = await self._used_length(spool_id)
+                    if used is None:
+                        self._spool_missing(spool_id)
+                        await self._save_usage()
+                        break
+                    if operation is not None and 'before' in operation:
+                        applied = (used - operation['before']
+                                   >= operation['length'] - 0.000001)
+                    else:
+                        operation = dict(operation or {'length': available},
+                                         before=used)
+                        self._usage_operations[spool_id] = operation
+                length = operation['length'] if operation else available
+                if not applied:
+                    body = {'use_length': length}
+                    # Save the start length and the exact amount before the request can reach the server.
+                    await self._save_usage()
+                    response = await self.http_client.request(
+                        method='PUT', url=f"{self.spoolman_url}/v1/spool/{spool_id}/use", body=body)
+                    if response.has_error():
+                        if response.status_code == 404:
+                            self._spool_missing(spool_id)
+                            await self._save_usage()
+                        elif not self._error_logged:
+                            self._error_logged = True
+                            logging.info('Failed to update usage for spool %s: %s',
+                                         spool_id, self._get_response_error(response))
+                        break
+                self._usage_operations.pop(spool_id, None)
+                # The queue may have changed while the request was on the way.
+                remaining = self._inflight_reports.get(spool_id, 0.) - length
+                if remaining > 0.0000001:
+                    self._inflight_reports[spool_id] = remaining
+                else:
+                    self._inflight_reports.pop(spool_id, None)
+                self._save_usage(deferred=True)
+                self._error_logged = False
